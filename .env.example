# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values from your Supabase
# project (Dashboard -> Project Settings -> API).  NEVER commit .env.local.
# ---------------------------------------------------------------------------

# SAFE FOR THE BROWSER  (prefixed NEXT_PUBLIC_, so it is bundled into client JS)
# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# SAFE FOR THE BROWSER  (the "anon" / "publishable" key).
# It carries no special privileges: every query made with it is still
# restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY - NOT REQUIRED by this application.
# The app deliberately never uses the service-role key: every database call
# runs as the signed-in user so Row Level Security is always enforced.
# Leave this commented out. If you ever add an admin task (e.g. a cron job),
# store it ONLY in server environment variables and never prefix it with
# NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
